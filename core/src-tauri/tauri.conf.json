{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CopyPaste",
  "version": "1.2.0",
  "identifier": "io.github.jonathansfp.copypaste",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "rpm",
      "appimage"
    ],
    "publisher": "CopyPaste",
    "category": "Utility",
    "shortDescription": "Histórico de cópias, captura de tela, quadro e gravação",
    "longDescription": "Histórico de cópias com busca, captura de tela com anotações precisas, quadro de apresentação no estilo Excalidraw e gravação de tela com áudio.",
    "copyright": "GPL-3.0",
    "license": "GPL-3.0",
    "homepage": "https://github.com/jonathansfp/copypaste",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "xdotool",
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "xdotool",
          "libayatana-appindicator-gtk3"
        ]
      }
    }
  }
}
